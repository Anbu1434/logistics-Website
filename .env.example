# ==============================================================================
# Verdéa Skincare - Environment Configuration Example
# Copy this file to .env.local for local development
# ==============================================================================

# Node Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Brand Information
NEXT_PUBLIC_BRAND_NAME=Verdéa
NEXT_PUBLIC_BRAND_TAGLINE=Botanical Science. Radiant Skin.
NEXT_PUBLIC_BRAND_DESCRIPTION=Quiet luxury skincare rooted in botanical science and dermatological precision.
NEXT_PUBLIC_DOMAIN=verdeaskincare.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@verdeaskincare.com

# Database (PostgreSQL)
# For local Docker: postgresql://postgres:postgres@localhost:5432/verdea_db?schema=public
# For Neon / Supabase: postgresql://user:password@ep-xyz.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/verdea_db?schema=public"

# Auth.js / NextAuth
# Generate with `openssl rand -base64 32`
NEXTAUTH_SECRET=your-32-character-secret-key-goes-here
NEXTAUTH_URL=http://localhost:3000

# Payments: Stripe (Global)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Payments: Razorpay (India: UPI, NetBanking, Cards)
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...

# Email: Resend
RESEND_API_KEY=re_...
EMAIL_FROM="Verdéa <orders@verdeaskincare.com>"

# Cache & Rate Limiting (Redis)
REDIS_URL="redis://localhost:6379"

