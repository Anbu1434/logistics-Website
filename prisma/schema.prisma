// Verdéa Skincare E-Commerce Platform - Prisma Schema
// Quiet luxury meets botanical science

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// 1. CATALOG & PRODUCTS
// -----------------------------------------------------------------------------

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  image       String?
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([slug])
}

model Collection {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  badge       String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
}

model SkinConcern {
  id          String           @id @default(cuid())
  name        String           @unique
  slug        String           @unique
  description String?
  icon        String?
  products    ProductConcern[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Ingredient {
  id          String              @id @default(cuid())
  name        String
  inciName    String              @unique
  description String
  benefits    String              // JSON or comma separated string
  allergens   String?
  products    ProductIngredient[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model Product {
  id             String              @id @default(cuid())
  name           String
  slug           String              @unique
  subtitle       String?
  description    String
  howToUse       String?
  badge          String?             // "Best Seller", "New", "Award Winner"
  isFeatured     Boolean             @default(false)
  isArchived     Boolean             @default(false)
  
  // Relations
  categoryId     String?
  category       Category?           @relation(fields: [categoryId], references: [id])
  collectionId   String?
  collection     Collection?         @relation(fields: [collectionId], references: [id])
  
  variants       ProductVariant[]
  images         ProductImage[]
  concerns       ProductConcern[]
  ingredients    ProductIngredient[]
  reviews        Review[]
  questions      Question[]
  
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([slug])
  @@index([categoryId])
  @@index([isFeatured])
}

model ProductVariant {
  id             String         @id @default(cuid())
  productId      String
  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  sku            String         @unique
  name           String         // "30ml", "50ml", "Velvet Nude"
  size           String?
  shadeHex       String?
  barcode        String?
  
  // Pricing in minor units (paise/cents: 89900 = ₹899.00)
  price          Int
  compareAtPrice Int?
  costPrice      Int?
  
  // Inventory
  stock          Int            @default(100)
  lowStockAlert  Int            @default(10)
  weightGrams    Int            @default(150)
  
  cartItems      CartItem[]
  orderItems     OrderItem[]
  
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([sku])
  @@index([productId])
}

model ProductImage {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url          String
  altText      String
  isPrimary    Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([productId])
}

model ProductConcern {
  productId String
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  concernId String
  concern   SkinConcern @relation(fields: [concernId], references: [id], onDelete: Cascade)

  @@id([productId, concernId])
}

model ProductIngredient {
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  isKeyActive  Boolean    @default(false)

  @@id([productId, ingredientId])
}

// -----------------------------------------------------------------------------
// 2. REVIEWS, RATINGS & Q&A
// -----------------------------------------------------------------------------

model Review {
  id               String   @id @default(cuid())
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  rating           Int      // 1 to 5
  title            String
  content          String
  authorName       String
  authorEmail      String?
  skinType         String?
  verifiedPurchase Boolean  @default(false)
  status           String   @default("APPROVED") // PENDING, APPROVED, REJECTED
  helpfulCount     Int      @default(0)
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([productId])
  @@index([status])
}

model Question {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  question   String
  authorName String
  answer     String?
  answeredAt DateTime?
  createdAt  DateTime @default(now())

  @@index([productId])
}

// -----------------------------------------------------------------------------
// 3. CART, CHECKOUT & ORDERS
// -----------------------------------------------------------------------------

model Cart {
  id         String     @id @default(cuid())
  userId     String?    @unique
  guestId    String?    @unique
  items      CartItem[]
  couponCode String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([userId])
  @@index([guestId])
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int            @default(1)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([cartId, variantId])
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  customerEmail   String
  customerPhone   String?
  customerName    String
  
  // Financials in minor units
  subtotal        Int
  discountAmount  Int         @default(0)
  shippingAmount  Int         @default(0)
  taxAmount       Int         @default(0)
  totalAmount     Int
  currency        String      @default("INR")
  
  // Status state machine
  status          String      @default("PENDING") // PENDING, CONFIRMED, PROCESSING, SHIPPED, DELIVERED, CANCELLED, REFUNDED
  paymentStatus   String      @default("UNPAID")  // UNPAID, PAID, FAILED, REFUNDED
  paymentMethod   String      // STRIPE, RAZORPAY, COD
  paymentRefId    String?
  
  shippingAddress String      // Serialized JSON address
  billingAddress  String?     // Serialized JSON address
  
  items           OrderItem[]
  shipments       Shipment[]
  
  couponCode      String?
  customerNotes   String?
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([orderNumber])
  @@index([customerEmail])
  @@index([status])
}

model OrderItem {
  id             String         @id @default(cuid())
  orderId        String
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId      String
  variant        ProductVariant @relation(fields: [variantId], references: [id])
  
  productName    String
  variantName    String
  sku            String
  unitPrice      Int
  quantity       Int
  totalPrice     Int
  
  createdAt      DateTime       @default(now())

  @@index([orderId])
}

model Shipment {
  id             String    @id @default(cuid())
  orderId        String
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  trackingNumber String?
  carrier        String?   // "Delhivery", "BlueDart", "FedEx"
  status         String    @default("LABEL_CREATED")
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// -----------------------------------------------------------------------------
// 4. PROMOTIONS & MARKETING
// -----------------------------------------------------------------------------

model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique
  description    String?
  discountType   String    // PERCENTAGE, FIXED_AMOUNT, FREE_SHIPPING
  discountValue  Int       // e.g. 15 for 15% or 20000 for ₹200
  minSpend       Int?      // e.g. 99900 for ₹999
  maxDiscount    Int?
  usageLimit     Int?
  timesUsed      Int       @default(0)
  isActive       Boolean   @default(true)
  startsAt       DateTime  @default(now())
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([code])
  @@index([isActive])
}

model EmailSubscriber {
  id             String   @id @default(cuid())
  email          String   @unique
  source         String   @default("FOOTER_FORM")
  isConfirmed    Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@index([email])
}

// -----------------------------------------------------------------------------
// 5. CUSTOMER ACCOUNTS & ADMIN USERS
// -----------------------------------------------------------------------------

model Customer {
  id             String         @id @default(cuid())
  email          String         @unique
  passwordHash   String?
  name           String?
  phone          String?
  skinType       String?        // "Dry", "Oily", "Combination", "Sensitive"
  loyaltyPoints  Int            @default(100) // 100 welcome bonus points
  addresses      Address[]
  wishlist       WishlistItem[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([email])
}

model Address {
  id           String    @id @default(cuid())
  customerId   String
  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  fullName     String
  street       String
  apartment    String?
  city         String
  state        String
  postalCode   String
  country      String    @default("India")
  phone        String
  isDefault    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([customerId])
}

model WishlistItem {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
}

model AdminUser {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  role         String     @default("ADMIN") // OWNER, ADMIN, CATALOG_MANAGER, ORDER_MANAGER, SUPPORT
  isActive     Boolean    @default(true)
  auditLogs    AuditLog[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([email])
}

model AuditLog {
  id          String     @id @default(cuid())
  adminUserId String?
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  action      String     // "PRODUCT_CREATED", "ORDER_REFUNDED", etc.
  entity      String     // "Product", "Order"
  entityId    String?
  details     String?    // JSON details
  ipAddress   String?
  createdAt   DateTime   @default(now())

  @@index([action])
  @@index([createdAt])
}

